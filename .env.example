# ─── spring-demo DB ─────────────────────────────
DB_PORT=3306
DB_NAME=energy_db
DB_USER=root
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# ─── user-service DB ────────────────────────────
USER_DB_PORT=3306
USER_DB_NAME=user_db
USER_DB_USER=user_app
USER_DB_PASSWORD=change-me
USER_DB_ROOT_PASSWORD=change-me-root

# ─── device-service DB ──────────────────────────
DEVICE_DB_PORT=3306
DEVICE_DB_NAME=device_db
DEVICE_DB_USER=device_app
DEVICE_DB_PASSWORD=change-me
DEVICE_DB_ROOT_PASSWORD=change-me-root

# ─── auth-service DB ────────────────────────────
AUTH_DB_PORT=3306
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_app
AUTH_DB_PASSWORD=change-me
AUTH_DB_ROOT_PASSWORD=change-me-root

# ─── JWT ────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-secret-to-a-secure-random-256-bit-value
JWT_EXPIRATION_MS=86400000