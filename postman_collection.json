{
	"info": {
		"_postman_id": "a5e8f49a-3d21-4f9e-9130-energy-mgmt-001",
		"name": "Energy Management System - All Microservices",
		"description": "Complete Postman collection for all microservices routed via Nginx reverse proxy on port 80 (auth-service, user-service, device-service, and spring-demo).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost",
			"type": "string"
		},
		{
			"key": "authToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminUserId",
			"value": "11111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "clientUserId",
			"value": "22222222-2222-2222-2222-222222222222",
			"type": "string"
		},
		{
			"key": "sampleDeviceId",
			"value": "33333333-3333-3333-3333-333333333331",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "01 - Auth Service",
			"item": [
				{
					"name": "1.1 Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('authToken', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"admin\",\n    \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticates the admin user and extracts the JWT token into {{authToken}}."
					},
					"response": []
				},
				{
					"name": "1.2 Login (Client)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"client1\",\n    \"password\": \"client123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Authenticates a client user and returns their JWT token and role."
					},
					"response": []
				},
				{
					"name": "1.3 Register New Credential",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser_new\",\n    \"password\": \"pass1234\",\n    \"role\": \"CLIENT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Direct registration endpoint in auth-service."
					},
					"response": []
				},
				{
					"name": "1.4 Delete Credential by Username",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/user/testuser_new",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"user",
								"testuser_new"
							]
						},
						"description": "Endpoint used by user-service to delete credentials synchronously."
					},
					"response": []
				}
			]
		},
		{
			"name": "02 - User Service",
			"item": [
				{
					"name": "2.1 Get All Users",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user"
							]
						},
						"description": "Retrieves the list of all registered users without exposing passwords."
					},
					"response": []
				},
				{
					"name": "2.2 Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/user/{{clientUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"{{clientUserId}}"
							]
						},
						"description": "Fetches a specific user by UUID."
					},
					"response": []
				},
				{
					"name": "2.3 Create User (Auto-syncs to auth-service)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Alexandru Vasile\",\n    \"username\": \"alex_v\",\n    \"password\": \"securePass123\",\n    \"role\": \"CLIENT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user"
							]
						},
						"description": "Creates a new user profile in user_db AND automatically calls auth-service to create their login credentials."
					},
					"response": []
				},
				{
					"name": "2.4 Update User",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Alexandru Vasile Updated\",\n    \"username\": \"alex_v\",\n    \"password\": \"securePass123\",\n    \"role\": \"CLIENT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/user/{{clientUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"{{clientUserId}}"
							]
						},
						"description": "Updates an existing user's details."
					},
					"response": []
				},
				{
					"name": "2.5 Delete User (Cascades to device & auth)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/user/22222222-2222-2222-2222-222222222222",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"user",
								"22222222-2222-2222-2222-222222222222"
							]
						},
						"description": "Deletes user from user_db, unassigns their devices in device-service, and deletes their login credentials in auth-service."
					},
					"response": []
				}
			]
		},
		{
			"name": "03 - Device Service",
			"item": [
				{
					"name": "3.1 Get All Devices",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device"
							]
						},
						"description": "Retrieves all smart energy metering devices in the system."
					},
					"response": []
				},
				{
					"name": "3.2 Get Device by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device/{{sampleDeviceId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"{{sampleDeviceId}}"
							]
						},
						"description": "Retrieves the details of a single metering device by its UUID."
					},
					"response": []
				},
				{
					"name": "3.3 Get Devices by User ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device/user/{{clientUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"user",
								"{{clientUserId}}"
							]
						},
						"description": "Lists all smart meters currently assigned to a specific client user."
					},
					"response": []
				},
				{
					"name": "3.4 Create Device",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Smart Heat Pump Meter\",\n    \"description\": \"Monitors high-efficiency heat pump energy consumption\",\n    \"maxConsumption\": 850.0,\n    \"userId\": \"{{clientUserId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/device",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device"
							]
						},
						"description": "Creates a new smart metering device, optionally assigned to a client user."
					},
					"response": []
				},
				{
					"name": "3.5 Update Device",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Smart Meter Living Room - Calibrated\",\n    \"description\": \"Calibrated high-precision meter\",\n    \"maxConsumption\": 500.0,\n    \"userId\": \"{{clientUserId}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/device/{{sampleDeviceId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"{{sampleDeviceId}}"
							]
						},
						"description": "Updates the configuration or consumption limit of an existing device."
					},
					"response": []
				},
				{
					"name": "3.6 Assign Device to User",
					"request": {
						"method": "PATCH",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device/33333333-3333-3333-3333-333333333333/assign/{{clientUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"33333333-3333-3333-3333-333333333333",
								"assign",
								"{{clientUserId}}"
							]
						},
						"description": "Links a previously unassigned device to a client user."
					},
					"response": []
				},
				{
					"name": "3.7 Unassign All Devices for User",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device/user/{{clientUserId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"user",
								"{{clientUserId}}"
							]
						},
						"description": "Unlinks all devices assigned to a user without deleting the devices."
					},
					"response": []
				},
				{
					"name": "3.8 Delete Device",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/device/{{sampleDeviceId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"device",
								"{{sampleDeviceId}}"
							]
						},
						"description": "Permanently deletes a device from device_db."
					},
					"response": []
				}
			]
		},
		{
			"name": "04 - Spring Demo (Reference)",
			"item": [
				{
					"name": "4.1 Get All Persons",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/person",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"person"
							]
						},
						"description": "Fetches all person records from the reference spring-demo service."
					},
					"response": []
				}
			]
		}
	]
}
